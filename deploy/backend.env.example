# Copy outside the repository, chmod 600, and replace every REPLACE_ placeholder.
# Plain KEY=value syntax; no shell expansion, quotes or command substitution.
MHVIE_DOMAIN=REPLACE_WITH_YOUR_DOMAIN
MHVIE_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
MHVIE_SEARX=REPLACE_WITH_YOUR_HTTPS_SEARXNG_ENDPOINT
MHVIE_HOSTS=REPLACE_WITH_COMMA_SEPARATED_APPROVED_SOURCE_DOMAINS
# MHVIE_DATA is set to the prepared package's private data directory.
MHVIE_OCR=0
MHVIE_SEGMENTATION=0
MHVIE_IDENTITY_EXTERNAL_SEARCH=0
# Optional local models: install/benchmark dependencies and review licenses separately.
# Directories/files must exist locally; preparation does not download model weights.
# MHVIE_VISION_MODEL=/srv/mhvie/models/qwen-vision
# MHVIE_FLUX_MODEL=/srv/mhvie/models/flux
# MHVIE_QWEN_EDIT_MODEL=/srv/mhvie/models/qwen-edit
# MHVIE_EDIT_BACKEND=flux
# MHVIE_CLIP_WEIGHTS=/srv/mhvie/models/clip.safetensors
# MHVIE_AESTHETIC_WEIGHTS=/srv/mhvie/models/aesthetic.pth
# MHVIE_AESTHETIC_SHA256=REPLACE_WITH_ACTUAL_SHA256
